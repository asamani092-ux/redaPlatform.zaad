{
  "name": "ridaa-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "db:migrate": "prisma migrate deploy",
    "db:apply-pending": "./scripts/apply-pending.sh",
    "init": "prisma generate && tsx prisma/seed.ts",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:reset-admin": "prisma generate && tsx scripts/reset-admin.ts",
    "db:ensure-admin": "prisma generate && tsx scripts/ensure-admin.ts",
    "db:ensure-admin-if-empty": "prisma generate && tsx scripts/ensure-admin.ts --if-empty",
    "db:seed-once": "./scripts/seed-once.sh",
    "db:purge-launch": "tsx scripts/purge-for-launch.ts",
    "db:generate": "prisma generate",
    "test": "tsx tests/run-all.ts",
    "test:entitlement": "tsx tests/entitlement.integration.ts",
    "backup": "./scripts/backup.sh",
    "restore-drill": "./scripts/restore-drill.sh",
    "boot": "./scripts/boot.sh",
    "check:storage": "./scripts/check-storage-persist.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@zaad/design-system": "github:asamani092-ux/designSystemFinal#v1.2.11",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
