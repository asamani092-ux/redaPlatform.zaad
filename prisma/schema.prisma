// منصة معرض رداء — Prisma Schema
// Relations: both sides defined. IDs: cuid. Timestamps: createdAt/updatedAt.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  REGISTRATION
  RECEPTION
  DISTRIBUTION
  INVENTORY
  REPORTS
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceType {
  NORMAL
  EXCEPTION
}

enum StockMovementType {
  ADD
  DISPENSE
  RETURN
  /// خصم/حذف كمية من المخزون مع سبب
  REMOVE
}

enum OutboundMessageType {
  INVITATION
  THANK_YOU
  VOLUNTEER_THANKS
  SURVEY
  OTP
  TEST
}

enum OutboundMessageStatus {
  PENDING
  SENT
  FAILED
  STUBBED
}

model User {
  id           String   @id @default(cuid())
  mobile       String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs          AuditLog[]
  attendances        Attendance[]        @relation("AttendanceBy")
  dispenseOrders     DispenseOrder[]     @relation("DispenseBy")
  stockMovements     StockMovement[]     @relation("StockBy")
  invitesCreated     ExhibitionInvite[]  @relation("InviteBy")
  outboundMessages   OutboundMessage[]   @relation("MessageBy")
  passwordResets     PasswordReset[]
  volunteersCreated  Volunteer[]         @relation("VolunteerBy")

  @@index([role])
  @@index([lastActiveAt])
}

model AssociationOption {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiaries Beneficiary[]
}

/// مهام المتطوعين — قائمة قابلة للتعديل من الإعدادات
model VolunteerRoleOption {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments VolunteerTask[]
}

/// ربط متطوع بمهمة (متعدد لكل متطوع) — تراكمي عند الإضافة
model VolunteerTask {
  id        String   @id @default(cuid())
  volunteerId String
  roleId    String
  createdAt DateTime @default(now())

  volunteer Volunteer           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  role      VolunteerRoleOption @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([volunteerId, roleId])
  @@index([volunteerId])
  @@index([roleId])
}

/// متطوعو المعرض — تراكمي لكل معرض
model Volunteer {
  id           String    @id @default(cuid())
  exhibitionId String
  name         String
  mobile       String
  nationalId   String
  thanksSentAt DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exhibition Exhibition      @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  createdBy  User?           @relation("VolunteerBy", fields: [createdById], references: [id])
  tasks      VolunteerTask[]

  @@unique([exhibitionId, nationalId])
  @@index([exhibitionId])
  @@index([mobile])
}

model Beneficiary {
  id               String    @id @default(cuid())
  name             String
  nationalId       String    @unique
  mobile           String
  gender           Gender?
  neighborhood     String?
  city             String?
  birthDate        DateTime?
  notes            String?
  /// عدد التابعين / حجم الأسرة المستخدم في حساب الاستحقاق الفعلي
  dependentsCount  Int       @default(0)
  associationId    String?
  associationOther String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  association      AssociationOption?  @relation(fields: [associationId], references: [id])
  invites          ExhibitionInvite[]
  attendances      Attendance[]
  dispenseOrders   DispenseOrder[]
  surveyResponses  SurveyResponse[]
  outboundMessages OutboundMessage[]

  @@index([mobile])
  @@index([name])
  @@index([city])
  @@index([associationId])
  @@index([dependentsCount])
}

model Exhibition {
  id          String    @id @default(cuid())
  name        String    @unique
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  settings         ExhibitionSettings?
  invites          ExhibitionInvite[]
  attendances      Attendance[]
  inventoryItems   InventoryItem[]
  dispenseOrders   DispenseOrder[]
  stockMovements   StockMovement[]
  surveyResponses  SurveyResponse[]
  outboundMessages OutboundMessage[]
  liveDisplayLinks LiveDisplayLink[]
  stores           Store[]
  volunteers       Volunteer[]

  @@index([active])
}

/// رابط عرض حي فريد للشاشات — بلا تسجيل دخول؛ يُحذف لإيقافه
model LiveDisplayLink {
  id           String    @id @default(cuid())
  token        String    @unique
  exhibitionId String
  label        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId, createdAt])
  @@index([revokedAt])
}

model ExhibitionSettings {
  id                   String   @id @default(cuid())
  exhibitionId         String   @unique
  /// الاستحقاق الأساسي لكل معرض (قابل للتعديل من الإعدادات)
  baseEntitlement      Int      @default(1)
  /// استحقاق كل تابع (قطعة) — الكامل = الأساسي + التابعون × هذا الحقل (افتراضي: وحدة واحدة)
  dependentsEntitlement Int     @default(1)
  lowStockThreshold    Int      @default(10)
  /// مخطط سمات المخزون: [{key,label,options:string[]}] مثل نوع/صنف/لون/وحدة
  inventorySchemaJson  Json
  whatsappInviteTpl    String?
  whatsappThanksTpl    String?
  surveyQuestionsJson  Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
}

model ExhibitionInvite {
  id            String   @id @default(cuid())
  exhibitionId  String
  beneficiaryId String
  qrToken       String   @unique @default(cuid())
  invited       Boolean  @default(true)
  invitedAt     DateTime @default(now())
  invitedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exhibition  Exhibition  @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  invitedBy   User?       @relation("InviteBy", fields: [invitedById], references: [id])

  @@unique([exhibitionId, beneficiaryId])
  @@index([exhibitionId, invited])
  @@index([qrToken])
}

model Attendance {
  id            String         @id @default(cuid())
  exhibitionId  String
  beneficiaryId String
  type          AttendanceType @default(NORMAL)
  exceptionReason String?
  checkedInAt   DateTime       @default(now())
  checkedInById String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  exhibition  Exhibition  @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  checkedInBy User?       @relation("AttendanceBy", fields: [checkedInById], references: [id])

  @@unique([exhibitionId, beneficiaryId])
  @@index([exhibitionId, checkedInAt])
  @@index([type])
}

model InventoryItem {
  id           String   @id @default(cuid())
  exhibitionId String
  /// رمز صرف بسيط 4–5 أرقام — فريد داخل المعرض
  skuCode      String
  /// قيم السمات حسب مخطط الإعدادات
  attributesJson Json
  quantity     Decimal  @db.Decimal(12, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exhibition     Exhibition      @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  dispenseLines  DispenseLine[]
  stockMovements StockMovement[]

  @@unique([exhibitionId, skuCode])
  @@index([exhibitionId])
}

/// متجر مشارك يساهم بمنتجات في المخزون الموحّد للمعرض
model Store {
  id           String   @id @default(cuid())
  exhibitionId String
  name         String
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exhibition     Exhibition      @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([exhibitionId, name])
  @@index([exhibitionId, active])
}

model StockMovement {
  id             String            @id @default(cuid())
  exhibitionId   String
  inventoryItemId String
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  note           String?
  /// إسناد المساهمة/الصرف لمتجر (اختياري — إضافات المنصة بلا متجر)
  storeId        String?
  createdById    String?
  createdAt      DateTime          @default(now())

  exhibition    Exhibition    @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("StockBy", fields: [createdById], references: [id])

  @@index([exhibitionId, createdAt])
  @@index([inventoryItemId])
  @@index([storeId])
}

model DispenseOrder {
  id                  String   @id @default(cuid())
  exhibitionId        String
  beneficiaryId       String
  piecesCount         Int
  entitledOverride    Int?
  overrideReason      String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  exhibition  Exhibition    @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("DispenseBy", fields: [createdById], references: [id])
  lines       DispenseLine[]

  /// يُسمح بأكثر من صرف لنفس المستفيد (صرف استثنائي لاحق) — التاريخ تراكمي
  @@index([exhibitionId, beneficiaryId])
  @@index([exhibitionId, createdAt])
}

model DispenseLine {
  id              String  @id @default(cuid())
  dispenseOrderId String
  inventoryItemId String
  quantity        Decimal @db.Decimal(12, 3)

  dispenseOrder DispenseOrder @relation(fields: [dispenseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([dispenseOrderId])
  @@index([inventoryItemId])
}

/// إعدادات المنصة العامة (صف واحد ثابت id="app") — إعداد واتساب قابل للتعديل من الواجهة
model AppConfig {
  id                String   @id @default("app")
  /// "stub" = تسجيل داخلي بلا إرسال؛ أي قيمة أخرى = إرسال حقيقي عبر API
  whatsappProvider  String   @default("stub")
  whatsappApiUrl    String?
  whatsappApiToken  String?
  /// رقم المرسل المسجل لدى المزوّد — للعرض والتوثيق
  whatsappSender    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// رموز استعادة كلمة المرور — تُرسل عبر واتساب وتنتهي خلال 10 دقائق
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  metaJson   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model SurveyResponse {
  id            String   @id @default(cuid())
  exhibitionId  String
  beneficiaryId String
  /// معرّف الاستبيان داخل كتالوج المعرض (surveyQuestionsJson.surveys[].id)
  surveyId      String   @default("default")
  answersJson   Json
  createdAt     DateTime @default(now())

  exhibition  Exhibition  @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([exhibitionId, beneficiaryId, surveyId])
  @@index([exhibitionId, surveyId])
  @@index([exhibitionId])
}

model OutboundMessage {
  id            String                @id @default(cuid())
  exhibitionId  String?
  beneficiaryId String?
  type          OutboundMessageType
  status        OutboundMessageStatus @default(PENDING)
  payloadJson   Json?
  providerRef   String?
  errorMessage  String?
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  exhibition  Exhibition?  @relation(fields: [exhibitionId], references: [id])
  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  createdBy   User?        @relation("MessageBy", fields: [createdById], references: [id])

  @@index([status, type])
  @@index([exhibitionId])
}
