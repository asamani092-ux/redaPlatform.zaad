DATABASE_URL="postgresql://user:password@localhost:5432/ridaa?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
# الإنتاج: رابط HTTPS لدومين العميل (مطلوب)
# AUTH_URL="https://your-domain.example"
NEXTAUTH_URL="http://localhost:3100"
IDLE_TIMEOUT_MS="3600000"
ADMIN_MOBILE="0500000000"
# مطلوب لـ npm run init فقط — لا افتراضي في الكود؛ غيّرها فوراً بعد أول دخول
ADMIN_PASSWORD=
WHATSAPP_PROVIDER="stub"
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# ترقية مخطط المخزون القديم — opt-in فقط (افتراضي: لا)
SEED_MIGRATE_SCHEMA="0"

BACKUP_DIR="/data/backups"
UPLOADS_DIR="/data/uploads"
TRIAL_EVAL_ENABLED="false"
