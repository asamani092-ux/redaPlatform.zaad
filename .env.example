DATABASE_URL="postgresql://user:password@localhost:5432/ridaa?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
# الإنتاج: رابط HTTPS لدومين العميل (مطلوب)
# AUTH_URL="https://your-domain.example"
# محلي فقط — في السيرفر استخدم AUTH_URL أو احذف NEXTAUTH_URL لصالح المضيف
NEXTAUTH_URL="http://localhost:3100"
IDLE_TIMEOUT_MS="3600000"
ADMIN_MOBILE="0500000000"
ADMIN_PASSWORD="Admin@1234"
WHATSAPP_PROVIDER="stub"
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# ——— نشر / حماية البيانات ———
# أول تنصيب فقط =1 ثم أعد إلى 0 فوراً بعد نجاح البذرة
SEED_ON_BOOT="0"
# لا تعِد كتابة كلمة المدير إلا عند الطوارئ
SEED_RESET_ADMIN="0"
SEED_ACTIVATE_EXHIBITION="0"
SEED_MIGRATE_SCHEMA="0"
# نسخ SQL قبل كل ترحيل داخل الحاوية (يتطلب pg_dump + volume /data)
BACKUP_BEFORE_MIGRATE="1"
BACKUP_DIR="/data/backups"
UPLOADS_DIR="/data/uploads"
# لا تسمح بالترحيل دون نسخة إلا بوعي كامل
ALLOW_MIGRATE_WITHOUT_BACKUP="0"

# أوقف تقييم التجربة قبل الإطلاق النهائي
TRIAL_EVAL_ENABLED="false"
