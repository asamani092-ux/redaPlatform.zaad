# قالب 1: نص الدعوة + صورة البوستر (هيدر ثابت في القالب أو رابط أدناه)
# WHATSAPP_INVITE_TEMPLATE_ID="6a895725db1ee30c7eeb7add"
# اختياري إن كان هيدر البوستر ديناميكياً (رابط صورة عامة)
# WHATSAPP_INVITE_HEADER_IMAGE_URL="https://your-cdn/poster.png"
# قالب 2: نص + صورة الباركود (هيدر IMAGE ديناميكي لكل مدعو)
# WHATSAPP_INVITE_QR_TEMPLATE_ID=
# WHATSAPP_THANKS_TEMPLATE_ID="6a8c2eeeb329578bad4ce93b"
# WHATSAPP_SURVEY_TEMPLATE_ID="6a8c2f4a34f2194bfffdfb57"
# WHATSAPP_SURVEY_URL=

# ترقية مخطط المخزون القديم — opt-in فقط (افتراضي: لا)
SEED_MIGRATE_SCHEMA="0"

BACKUP_DIR="/data/backups"
UPLOADS_DIR="/data/uploads"
TRIAL_EVAL_ENABLED="false"
